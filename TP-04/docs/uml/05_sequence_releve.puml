@startuml
title Diagramme de sequence - Production d'un releve de notes
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 130
skinparam roundcorner 8
skinparam ArrowColor #34495E
skinparam backgroundColor white
actor "Utilisateur" as U
participant "Menu\n(console)" as M
participant "Departement" as D
participant "UE" as UE
participant "Note" as N
participant "Fichier\nreleve_<matricule>.txt" as F

U -> M : choisir "Releve de notes" + matricule
M -> D : afficherReleve(os, matricule)
D -> D : calculerBilan(matricule)
loop pour chaque UE du niveau
  D -> UE : getMatieres()
  loop pour chaque matiere
    D -> N : trouverNote(matricule, codeMatiere)
    N --> D : note ou absente
  end
  D -> D : moyenne UE = somme(note x coef) / somme(coef)\nUE validee si moyenne >= 10
end
D -> D : moyenne generale = somme(moy UE x credits) / somme(credits)\ndecision (Admis / compensation / Ajourne / En attente)
D --> M : releve formate
M --> U : afficher le releve
opt exportation demandee
  M -> D : exporterReleve(matricule, "releves")
  D -> F : ecrire le releve
end
@enduml
